<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:orientation="vertical">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <FrameLayout
            android:id="@+id/preview_layout"
            android:layout_width="1280px"
            android:layout_height="720px">

            <com.adl.lib.AdlCameraPreviewView
                android:id="@+id/preview_view"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <com.adl.base.overlay.SportOverlayVessel
                android:id="@+id/overlay"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

        </FrameLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:background="#8fffffff"
            android:orientation="vertical"
            android:paddingLeft="12dp"
            android:paddingTop="16dp"
            android:paddingBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="@dimen/qb_px_56"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="@dimen/qb_px_160"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/qb_px_16"
                    android:text="摄像头:"
                    android:textColor="#000000"
                    android:textSize="@dimen/text_size_16" />

                <RadioGroup
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <RadioButton
                        android:id="@+id/type_pad"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:text="内置"
                        android:textColor="#000000"
                        android:textSize="@dimen/text_size_16" />

                    <RadioButton
                        android:id="@+id/type_ipc"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="@dimen/qb_px_16"
                        android:gravity="center_vertical"
                        android:text="IPC"
                        android:textColor="#000000"
                        android:textSize="@dimen/text_size_16" />

                </RadioGroup>

                <View
                    android:layout_width="2px"
                    android:layout_height="12dp"
                    android:layout_marginLeft="16dp"
                    android:background="#354DD6" />

                <LinearLayout
                    android:id="@+id/layout_1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="@dimen/qb_px_120"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="@dimen/qb_px_32"
                        android:text="分辨率: "
                        android:textColor="#000000"
                        android:textSize="@dimen/text_size_16" />

                    <Spinner
                        android:id="@+id/sp_resolution"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="@dimen/qb_px_16"
                        android:entries="@array/resolution" />

                    <TextView
                        android:layout_width="@dimen/qb_px_120"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="@dimen/qb_px_32"
                        android:text="FPS: "
                        android:textColor="#000000"
                        android:textSize="@dimen/text_size_16" />

                    <Spinner
                        android:id="@+id/sp_fps"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="@dimen/qb_px_16"
                        android:entries="@array/fps" />

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/layout_2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="16dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:visibility="gone">

                    <EditText
                        android:id="@+id/ed_ip"
                        android:layout_width="120dp"
                        android:layout_height="wrap_content"
                        android:background="@null"
                        android:singleLine="true"
                        android:text="172.16.3.55"
                        android:textColor="#000000"
                        android:textColorHint="#8f000000"
                        android:textSize="@dimen/text_size_16" />

                    <View
                        android:layout_width="2px"
                        android:layout_height="12dp"
                        android:layout_marginLeft="16dp"
                        android:layout_marginRight="16dp"
                        android:background="#354DD6" />

                    <EditText
                        android:id="@+id/ed_name"
                        android:layout_width="100dp"
                        android:layout_height="wrap_content"
                        android:background="@null"
                        android:singleLine="true"
                        android:text="admin"
                        android:textColor="#000000"
                        android:textColorHint="#8f000000"
                        android:textSize="@dimen/text_size_16" />

                    <View
                        android:layout_width="2px"
                        android:layout_height="12dp"
                        android:layout_marginLeft="16dp"
                        android:layout_marginRight="16dp"
                        android:background="#354DD6" />

                    <EditText
                        android:id="@+id/ed_pwd"
                        android:layout_width="100dp"
                        android:layout_height="wrap_content"
                        android:background="@null"
                        android:singleLine="true"
                        android:text="zy123456"
                        android:textColor="#000000"
                        android:textColorHint="#8f000000"
                        android:textSize="@dimen/text_size_16" />

                </LinearLayout>

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="@dimen/qb_px_56"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="@dimen/qb_px_160"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/qb_px_16"
                    android:text="视频录制:"
                    android:textColor="#000000"
                    android:textSize="@dimen/text_size_16" />

                <RadioGroup
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <RadioButton
                        android:id="@+id/type_record_1"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:text="代码录制"
                        android:textColor="#000000"
                        android:textSize="@dimen/text_size_16" />

                    <RadioButton
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="@dimen/qb_px_16"
                        android:gravity="center_vertical"
                        android:text="IPC录制"
                        android:textColor="#000000"
                        android:textSize="@dimen/text_size_16" />

                </RadioGroup>

                <Spinner
                    android:id="@+id/sp_bitrate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/qb_px_16"
                    android:entries="@array/bitrate"
                    android:visibility="gone" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="@dimen/qb_px_56"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:visibility="gone">

                <TextView
                    android:layout_width="@dimen/qb_px_160"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/qb_px_16"
                    android:text="模型:"
                    android:textColor="#000000"
                    android:textSize="@dimen/text_size_16" />

                <CheckBox
                    android:id="@+id/model_1000"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="人框(1000)"
                    android:textColor="#000000"
                    android:textSize="@dimen/text_size_16" />

                <CheckBox
                    android:id="@+id/model_2000"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="12dp"
                    android:text="姿态(2000)"
                    android:textColor="#000000"
                    android:textSize="@dimen/text_size_16" />

                <CheckBox
                    android:id="@+id/model_3002"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="12dp"
                    android:text="分类1 (3002)"
                    android:textColor="#000000"
                    android:textSize="@dimen/text_size_16" />

                <CheckBox
                    android:id="@+id/model_3003"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="12dp"
                    android:text="分类2 (3003)"
                    android:textColor="#000000"
                    android:textSize="@dimen/text_size_16" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/bnt_preview"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/qb_px_16"
                    android:text="预览"
                    android:textColor="#000000"
                    android:textSize="@dimen/text_size_16" />

                <Button
                    android:id="@+id/bnt_start"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/qb_px_16"
                    android:text="开始检测"
                    android:textColor="#000000"
                    android:textSize="@dimen/text_size_16" />

                <Button
                    android:id="@+id/bnt_recording"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/qb_px_16"
                    android:text="开始录像"
                    android:textColor="#000000"
                    android:textSize="@dimen/text_size_16" />

                <Button
                    android:id="@+id/bnt_reset"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/qb_px_16"
                    android:text="重置"
                    android:textColor="#000000"
                    android:textSize="@dimen/text_size_16" />

            </LinearLayout>

        </LinearLayout>

        <Button
            android:id="@+id/bnt_close"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentRight="true"
            android:layout_margin="16dp"
            android:text="退出"
            android:textColor="#000000"
            android:textSize="@dimen/text_size_16" />

    </RelativeLayout>

</LinearLayout>
