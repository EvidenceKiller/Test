<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_dialog">

    <RelativeLayout
        android:id="@+id/top_layout"
        android:layout_width="match_parent"
        android:layout_height="@dimen/qb_px_64">

        <TextView
            android:id="@+id/tv_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:text="选择文件夹"
            android:textColor="@color/color_white"
            android:textSize="@dimen/qb_px_16" />

        <ImageView
            android:id="@+id/bnt_close"
            android:layout_width="@dimen/qb_px_64"
            android:layout_height="@dimen/qb_px_64"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"
            android:layout_marginRight="@dimen/qb_px_16"
            android:padding="@dimen/qb_px_8"
            android:src="@drawable/sv_close" />

    </RelativeLayout>

    <View
        android:id="@+id/line"
        android:layout_width="match_parent"
        android:layout_height="1px"
        android:layout_below="@id/top_layout"
        android:background="#88ffffff" />

    <LinearLayout
        android:id="@+id/content_layout"
        android:layout_width="match_parent"
        android:layout_height="@dimen/qb_px_320"
        android:layout_below="@id/line"
        android:layout_marginLeft="@dimen/qb_px_72"
        android:layout_marginTop="@dimen/qb_px_16"
        android:layout_marginRight="@dimen/qb_px_72"
        android:background="@drawable/bg_dialog_content"
        android:orientation="horizontal">

        <ListView
            android:id="@+id/list_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:divider="@null"
            android:dividerHeight="0dp" />

    </LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@+id/content_layout"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="@dimen/qb_px_48"
        android:layout_marginBottom="@dimen/qb_px_48">

        <TextView
            android:id="@+id/bnt_cancel"
            android:layout_width="@dimen/qb_px_164"
            android:layout_height="@dimen/qb_px_60"
            android:background="@drawable/bg_dialog_bnt_cancel"
            android:gravity="center"
            android:text="取消"
            android:textColor="@color/color_white"
            android:textSize="@dimen/qb_px_24" />

        <TextView
            android:id="@+id/bnt_ok"
            android:layout_width="@dimen/qb_px_164"
            android:layout_height="@dimen/qb_px_60"
            android:layout_marginLeft="@dimen/qb_px_48"
            android:background="@drawable/bg_dialog_bnt_ok"
            android:gravity="center"
            android:text="确定"
            android:textColor="@color/color_white"
            android:textSize="@dimen/qb_px_24" />
    </LinearLayout>

</RelativeLayout>