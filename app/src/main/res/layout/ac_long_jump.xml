<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_black">

    <com.ai.jump.lib.SportLongJumpLayout
        android:id="@+id/long_jump_layout"
        android:layout_width="1920px"
        android:layout_height="1080px" />

    <LinearLayout
        android:id="@+id/layout_2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:orientation="horizontal">

        <Button
            android:id="@+id/bnt_start"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="开始运动" />

        <Button
            android:id="@+id/bnt_stop"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="停止运动" />

        <Button
            android:id="@+id/bnt_next"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="下一帧" />

        <Button
            android:id="@+id/bnt_reset"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="重置" />

        <Button
            android:id="@+id/bnt_change"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="自动模式" />

        <TextView
            android:id="@+id/score_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/qb_px_24"
            android:text="--个"
            android:textColor="#ffffff"
            android:textSize="@dimen/text_size_16" />

        <TextView
            android:id="@+id/info_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/qb_px_24"
            android:textColor="#ffffff"
            android:textSize="@dimen/text_size_16" />

    </LinearLayout>

    <ListView
        android:id="@+id/list_view"
        android:layout_width="240dp"
        android:layout_height="match_parent"
        android:layout_alignParentRight="true"
        android:background="#000000"
        android:divider="@null"
        android:dividerHeight="0dp" />

    <ScrollView
        android:layout_width="@dimen/qb_px_480"
        android:layout_height="wrap_content"
        android:layout_toLeftOf="@id/list_view">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <TextView
                android:id="@+id/log_tv"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#9f000000"
                android:paddingLeft="16dp"
                android:paddingBottom="16dp"
                android:textColor="#ffffff"
                android:textSize="14sp" />

            <ImageView
                android:id="@+id/preview"
                android:layout_width="640px"
                android:layout_height="360px"
                android:layout_marginTop="@dimen/qb_px_64"
                android:scaleType="centerCrop" />

        </LinearLayout>

    </ScrollView>

    <Button
        android:id="@+id/bnt_close"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:text="退出"
        android:textSize="@dimen/text_size_16" />

</RelativeLayout>
